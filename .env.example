# Used by the Apps Script scraper (set as Script Properties in script.google.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string (Dashboard -> Connect -> Direct connection).
# Used locally for dumping the schema (see supabase/README.md).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
