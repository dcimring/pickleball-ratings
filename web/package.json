    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
